# ─────────────────────────────────────────────────────────────────────────────
# Kalshi Trading Bot — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# SWITCHING DEMO ↔ PRODUCTION
#   Change only:  KALSHI_ENV=demo   or   KALSHI_ENV=production
#   Risk limits, database, and logs use KALSHI_DEMO_* / KALSHI_PROD_* below.
#   Verify:  python -c "import config; print(config.ENV, config.MAX_POSITION_CENTS)"
#   Full roadmap: docs/ROADMAP.md
# ─────────────────────────────────────────────────────────────────────────────

# ── Active environment (single switch) ────────────────────────────────────────
KALSHI_ENV=demo
# KALSHI_ENV=production

# ── Authentication (store BOTH — selected by KALSHI_ENV) ───────────────────────
# Demo keys:  https://demo.kalshi.com/account/api-keys
# Prod keys:  https://kalshi.com/account/api-keys
#
# Encode a PEM (PowerShell):
#   python -c "import base64, pathlib; print(base64.b64encode(pathlib.Path('demo-key.pem').read_bytes()).decode())"

KALSHI_DEMO_API_KEY_ID=your-demo-api-key-uuid
KALSHI_DEMO_PRIVATE_KEY_B64=your-demo-key-base64-here

KALSHI_PROD_API_KEY_ID=your-prod-api-key-uuid
KALSHI_PROD_PRIVATE_KEY_B64=your-prod-key-base64-here

# Optional legacy single pair (fallback if env-specific vars above are empty)
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY_B64=

# ── Risk & paths — DEMO profile ───────────────────────────────────────────────
KALSHI_DEMO_MAX_POSITION_CENTS=10000
KALSHI_DEMO_DAILY_LOSS_LIMIT_CENTS=50000
KALSHI_DEMO_MAX_DRAWDOWN_PCT=0.10
KALSHI_DEMO_MAX_CONCURRENT_POSITIONS=5
KALSHI_DEMO_DB_PATH=kalshi_bot_demo.db
KALSHI_DEMO_LOG_FILE=kalshi_bot_demo.jsonl

# ── Risk & paths — PRODUCTION profile (micro-pilot defaults) ──────────────────
KALSHI_PROD_MAX_POSITION_CENTS=100
KALSHI_PROD_DAILY_LOSS_LIMIT_CENTS=500
KALSHI_PROD_MAX_DRAWDOWN_PCT=0.05
KALSHI_PROD_MAX_CONCURRENT_POSITIONS=1
KALSHI_PROD_DB_PATH=kalshi_bot_prod.db
KALSHI_PROD_LOG_FILE=kalshi_bot_prod.jsonl

# Generic overrides (apply to both envs if DEMO_/PROD_ not set for that key)
# KALSHI_MAX_POSITION_CENTS=10000
# KALSHI_DAILY_LOSS_LIMIT_CENTS=50000
# KALSHI_DB_PATH=kalshi_bot.db
# KALSHI_LOG_FILE=kalshi_bot.jsonl
# KALSHI_FEE_PER_CONTRACT_CENTS=7.0

# ── Markets to trade ──────────────────────────────────────────────────────────
KALSHI_TICKERS=PRES-2024-DEM,INXD-23DEC29-B4700

# ── Strategy ──────────────────────────────────────────────────────────────────
# kelly | green_up | arb | high_prob  (CLI --strategy overrides)
KALSHI_STRATEGY=high_prob
# KALSHI_DEFAULT_STRATEGY=high_prob

# High-probability strategy
# KALSHI_HP_MIN_YES_ASK=85
# KALSHI_HP_MAX_YES_ASK=97
# KALSHI_HP_MIN_ROI_PCT=2.0
# KALSHI_HP_USE_FEE_ADJUSTED_ROI=true
# KALSHI_HP_ENTRY_MODE=passive
# KALSHI_HP_EXIT_MODE=passive
# KALSHI_HP_POST_FILL=hold
# KALSHI_HP_STAKE_CENTS=5000
# KALSHI_HP_TAKE_PROFIT_PCT=0.30

# Auto-discovery (alternative to KALSHI_TICKERS)
# KALSHI_DISCOVER=true
# KALSHI_DISCOVER_CATEGORY=Sports
# KALSHI_DISCOVER_TOP=10

# Kelly: model P(YES) per ticker — TICKER:PROB,TICKER2:PROB
# KALSHI_MODEL_PROB=PRES-2024-DEM:0.62

# Green-up
# KALSHI_GREEN_UP_ENTRY_MAX=25
# KALSHI_GREEN_UP_HEDGE_TRIGGER=68
# KALSHI_GREEN_UP_HEDGE_MODE=full_green
# KALSHI_GREEN_UP_STOP_LOSS=0.40
# KALSHI_GREEN_UP_ENTRY_MODE=passive
# KALSHI_GREEN_UP_EXIT_MODE=cross_spread
# KALSHI_GREEN_UP_LIMIT_OFFSET=-2
# KALSHI_GREEN_UP_MAX_CYCLES_PER_TICKER=0

# Live-market gates (default on)
# KALSHI_LIVE_ONLY=true
# KALSHI_LIVE_MAX_MINUTES_SINCE_UPDATE=120
# KALSHI_LIVE_MAX_MINUTES_TO_CLOSE=360
# KALSHI_LIVE_MAX_BOOK_STALE_MINUTES=30
# KALSHI_LIVE_MAX_TRADE_STALE_MINUTES=120

# Pre-trade gates
# KALSHI_MIN_BALANCE_CENTS=5000
# KALSHI_MIN_MINUTES_TO_EXPIRY=10
# KALSHI_BLOCK_LOW_BALANCE=true
# KALSHI_ORDER_MAX_RETRIES=3
# KALSHI_PORTFOLIO_RISK_SYNC_SECONDS=30

# Arbitrage: complementary pairs — TICKER_A:TICKER_B
# KALSHI_ARB_PAIRS=

# Live terminal table in main.py (seconds; 0 = off)
KALSHI_MONITOR_INTERVAL=15

# ── Database ──────────────────────────────────────────────────────────────────
# Per-env paths above (KALSHI_DEMO_DB_PATH / KALSHI_PROD_DB_PATH) are preferred.
# KALSHI_POSTGRES_URL=postgresql://user:password@localhost:5432/kalshi

# ── Logging ───────────────────────────────────────────────────────────────────
KALSHI_LOG_LEVEL=INFO
